# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/cablesync?retryWrites=true&w=majority

# Port for the Express server
PORT=5000

# Simple operator PIN (replaces full auth for MVP - see middleware/auth.js)
OPERATOR_PIN=1234

# Comma-separated list of allowed frontend origins (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
